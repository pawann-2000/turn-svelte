{
	"name": "svelte-turn-page",
	"version": "0.1.0",
	"description": "Svelte component library for modern page flipping books.",
	"type": "module",
	"license": "SEE LICENSE IN license.txt",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"README.md",
		"license.txt"
	],
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./turn-engine": {
			"import": {
				"types": "./dist/turn-engine.d.ts",
				"default": "./dist/turn-engine.js"
			},
			"require": {
				"types": "./dist/turn-engine.d.cts",
				"default": "./dist/turn-engine.cjs"
			},
			"default": "./dist/turn-engine.js"
		},
		"./types": {
			"import": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.js"
			},
			"require": {
				"types": "./dist/types.d.cts",
				"default": "./dist/types.cjs"
			},
			"default": "./dist/types.js"
		}
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "npm run package && tsdown",
		"package": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"publint": "npm_config_cache=/tmp/svelte-turn-page-npm-cache publint",
		"lint": "npm run check && npm run build && npm run publint",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"publint": "^0.3.23",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	}
}
